# ---------------------------------------------------------------------------
# Build-time variables (set these in Netlify > Site configuration >
# Environment variables; NEXT_PUBLIC_* values are baked into the static HTML).
# ---------------------------------------------------------------------------

# Production origin, used for canonical URLs, sitemap, robots, Open Graph,
# and JSON-LD. No trailing slash. Pick ONE of www / non-www and make it the
# Netlify primary domain so the redirect matches.
NEXT_PUBLIC_SITE_URL=https://steviecainhaircare.com

# Google Search Console > Settings > Ownership verification > HTML tag.
# Paste only the `content` value. Leave unset to render no tag.
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=

# ---------------------------------------------------------------------------
# GoHighLevel maintenance scripts only (scripts/ghl-*.mjs). Never committed,
# never needed by the build. Create a Private Integration in the Stevie Cain
# sub-account (Settings > Private Integrations) with calendar + users scopes.
# ---------------------------------------------------------------------------
GHL_PRIVATE_TOKEN=pit-xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
# The sub-account (location) ID, from Settings > Business Profile.
GHL_LOCATION_ID=
# Stevie's GHL user ID. Leave blank and the script picks the sole user in the
# sub-account, or lists them if there is more than one.
GHL_USER_ID=
